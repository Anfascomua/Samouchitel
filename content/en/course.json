        {
          "en": "Nice to meet you.",
          "ru": "Приятно познакомиться.",
          "example": "Nice to meet you, Kate."
        },
        {
          "en": "I am from Ukraine.",
          "ru": "Я из Украины.",
          "example": "I am from Ukraine."
        }
      ]
    },
    {
      "id": "basic",
      "title": "Первые фразы",
      "subtitle": "Yes, No, Please, Thank you",
      "explain": "Слова, которые понадобятся с первого дня.",
      "words": [
        {
          "en": "Yes.",
          "ru": "Да.",
          "example": "Yes, please."
        },
        {
          "en": "No.",
          "ru": "Нет.",
          "example": "No, thank you."
        },
        {
          "en": "Please.",
          "ru": "Пожалуйста.",
          "example": "Coffee, please."
        },
        {
          "en": "Thank you.",
          "ru": "Спасибо.",
          "example": "Thank you very much."
        },
        {
          "en": "Sorry.",
          "ru": "Извините.",
          "example": "Sorry, I don't understand."
        }
      ]
    },
    {
      "id": "understand",
      "title": "Если не понимаете",
      "subtitle": "Repeat, slower, I don't understand",
