        {
          "en": "Please repeat.",
          "ru": "Повторите, пожалуйста.",
          "example": "Please repeat that."
        },
        {
          "en": "Speak slowly, please.",
          "ru": "Говорите медленнее, пожалуйста.",
          "example": "Speak slowly, please."
        },
        {
